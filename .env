THEME=https://raw.githubusercontent.com/thepharaohart/Obsidian-RetroOS98/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowGraphDepthControl=false
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true
SITE_NAME_HEADER=G-man's Hunter
SITE_MAIN_LANGUAGE=en
SITE_BASE_URL=https://aj-gman.github.io/hunter/
SHOW_CREATED_TIMESTAMP=false
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a
SHOW_UPDATED_TIMESTAMP=false
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --show-note-header-on-hover: enable; --crop-root-corners: enable; --art-deco-color: var(--color-accent); --art-deco-style-hr: enable; --art-deco-style-fonts: disable; --art-deco-style-sidebar-corners: enable; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-windows is-frameless is-hidden-frameless is-maximized obsidian-app styled-scrollbars show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager fas-adaptive-accent fas-silver-light fas-silver-dark fas-sans-serif fas-bg-textures fas-vault-menu-hover fas-callout-cite-alt fas-callout-infobox fas-headings-accent fas-h1-display fas-hr fas-skin-art-deco
USE_FULL_RESOLUTION_IMAGES=false
dgPassFrontmatter=false